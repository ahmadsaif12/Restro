#!/usr/bin/env bash
set -euo pipefail

log() {
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*"
}

wait_for_postgres() {
  if command -v pg_isready >/dev/null 2>&1; then
    log "Waiting for Postgres..."
    until pg_isready -h "${DB_HOST:-db}" -p "${DB_PORT:-5432}" -U "${DB_USER:-postgres}" >/dev/null 2>&1; do
      sleep 1
    done
  fi
}

